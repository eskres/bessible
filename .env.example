# Bessible — environment configuration template
# Copy to .env and fill in: cp .env.example .env

# Container image owner for GHCR (defaults to eskres)
IMAGE_OWNER=eskres

# Deployment domain and Traefik proxy network (optional, defaults to localhost / proxy)
# DOMAIN=bessible.example.com
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure
# Rate limiting + security headers are defined as Docker-provider labels in docker-compose.yml
# (self-contained; nothing to configure on the shared Traefik host). Override the defaults here:
# RATE_LIMIT_API_AVERAGE=5    # requests/sec per source IP to /runs, /me, /demo, /capacity, /site-data, /inspire
# RATE_LIMIT_API_BURST=10
# RATE_LIMIT_WEB_AVERAGE=20   # requests/sec per source IP to the web app
# RATE_LIMIT_WEB_BURST=40
# TRAEFIK_MIDDLEWARES_API=bessible-security-headers@docker,bessible-api-ratelimit@docker
# TRAEFIK_MIDDLEWARES_WEB=bessible-security-headers@docker,bessible-web-ratelimit@docker
# NEXT_PUBLIC_API_URL=

# =============================================================================
# 1. ESSENTIAL (Required for pipeline reasoning and live execution)
# =============================================================================

# Firebase Auth (Google sign-in for web app and API authentication)
# Optional master toggle (defaults to true if FIREBASE_* keys are set)
# AUTH_ENABLED=false turns sign-in off in both the web UI and the API: every caller is one local user.
# Local dev only; never on a public deployment.
AUTH_ENABLED=true
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
ALLOWED_EMAILS=

# Google Maps JavaScript API (the web map). A browser key, separate from GOOGLE_API_KEY: it is visible in page
# source, so restrict it in Cloud Console to the Maps JavaScript API and to localhost + your domain (HTTP referrers).
# Map ID: Cloud Console > Maps > Map IDs (JavaScript, vector). Empty = Google's DEMO_MAP_ID, fine for local dev.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Google Routes API (road route from the site to the substation, used for cable cost). A SERVER key, separate from
# the browser key above: restrict it to the Routes API (and your server's IP). Empty = straight-line cable runs.
GOOGLE_ROUTES_API_KEY=

# Google DeepMind / AI Studio (for Gemini reasoning calls)
# Used by the CLI and scripts as YOUR key. A run gets its key from the user who started it, never from the server.
GOOGLE_API_KEY=

# Master secret that seals each run's Google key before it enters Temporal. The CLI, API and worker must share it.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KEY_ENCRYPTION_SECRET=

# Pydantic AI Gateway (proxies self-hosted models on Modal)
PYDANTIC_AI_GATEWAY_API_KEY=

# Modal credentials (if not already logged in via `uv run modal setup`). Operator-side: enables the Modal classifier.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# Classifier backend: auto (modal if a token exists, else llm, else keyword heuristic) | modal | llm | heuristic
CLASSIFIER_BACKEND=auto


# =============================================================================
# 2. OPTIONAL (Tracing, classification, and enhanced external data/maps)
# =============================================================================

# Logfire (agent and activity tracing)
LOGFIRE_TOKEN=

# TypeSafe / Jev (typed classification)
TYPESAFE_API_KEY=

# UK Power Networks open data portal (free key: ukpowernetworks.opendatasoft.com -> account -> API keys)
UKPN_API_KEY=

# SSEN Transmission open data portal (north of Scotland; free key: ssentransmission.opendatasoft.com -> account -> API keys)
SSEN_API_KEY=

# National Grid Electricity Distribution connected data portal (Midlands, South West, South Wales)
NGED_API_KEY=

# SP Energy Networks open data portal (central & southern Scotland, Merseyside, North Wales, Cheshire; free key: spenergynetworks.opendatasoft.com -> account -> API keys)
SPEN_API_KEY=

# Northern Powergrid open data portal (North East, Yorkshire; free key: northernpowergrid.opendatasoft.com -> account -> API keys)
NPG_API_KEY=

# Tavily search (local news for the sentiment stage; key: app.tavily.com). Operator-side, like UKPN_API_KEY.
# Empty = the stage reports "news search not configured" and no opposition index.
TAVILY_API_KEY=

# Ordnance Survey Data Hub (real OS maps tiles in site report; free key: osdatahub.os.uk)
OS_API_KEY=


# =============================================================================
# 3. DEFAULTS & INFRASTRUCTURE (Pre-configured for local development)
# =============================================================================

# Temporal local dev server (start with `temporal server start-dev` or `./scripts/dev.sh`)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Model overrides & routing
GEMINI_MODEL=gemini-3.8-flash
PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy
MODAL_GATEWAY_ROUTE=modal
MODAL_MODEL=google/gemma-4-31B-it
